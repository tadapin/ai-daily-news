<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.tadapin.ai-daily-news</string>
  <key>ProgramArguments</key><array><string>/Users/bohnen/Project/ai-daily-news/daily-ai-news-generator/scripts/run_scheduled_publish.sh</string></array>
  <key>WorkingDirectory</key><string>/Users/bohnen/Project/ai-daily-news</string>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/tmp/ai-daily-news-publish.log</string>
  <key>StandardErrorPath</key><string>/tmp/ai-daily-news-publish.error.log</string>
</dict></plist>
